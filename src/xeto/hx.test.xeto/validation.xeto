// Type with a custom rule registered on it
TestRuleSubject: Dict {
  code: Str?
}

// Custom rule bound to testXeto::ValidateTestCodePrefix
@testCodePrefix: ValidateRule {
  on: TestRuleSubject
  msg: "Code '$code' must start with 'T'"
}

// Custom rule declared without a Fantom class; loads unbound and
// never runs, but stays visible in the registry
@testUnbound: ValidateRule {
  on: TestRuleSubject
  msg: "Never reported"
}
