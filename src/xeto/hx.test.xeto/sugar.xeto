// sugar inherited from DischargeFanRunCmd
ColdDeckDischargeFanRunCmd: DischargeFanRunCmd { coldDeck }

// scalar constraint
Stage2DischargeFanRunCmd: DischargeFanRunCmd { stage: 2 }

// And of sugar specs which share one anchor
ColdDeckStage2DischargeFanRunCmd: ColdDeckDischargeFanRunCmd & Stage2DischargeFanRunCmd

// sugar with query constraint excluded from constraints
StandardFanVav: Vav <sugar> {
  singleDuct
  points: {
    DischargeFanRunCmd
  }
}
