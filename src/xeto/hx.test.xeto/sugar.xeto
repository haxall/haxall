// sugar inherited from DischargeFanRunCmd
ColdDeckDischargeFanRunCmd: DischargeFanRunCmd { coldDeck }

// invariant scalar constraint
Stage2DischargeFanRunCmd: DischargeFanRunCmd { stage: Int <invariant> 2 }

// invariant which conflicts with Stage2DischargeFanRunCmd
Stage3DischargeFanRunCmd: DischargeFanRunCmd { stage: Int <invariant> 3 }

// same anchor and constraints as ph.points.sugar::DischargeFanRunCmd
MyDischargeFanRunCmd: DuctFanRunCmd <sugar> { discharge }

// And of sugar specs which share one anchor
ColdDeckStage2DischargeFanRunCmd: ColdDeckDischargeFanRunCmd & Stage2DischargeFanRunCmd

// sugar with query constraint excluded from constraints
StandardFanVav: Vav <sugar> {
  singleDuct
  points: {
    DischargeFanRunCmd
  }
}

// query items are anonymous sugar
SugarItemsEquip: Equip {
  points: {
    fan: DuctFanRunCmd { discharge }
  }
}

// mixin adds constraint to sugar spec
+ReturnFanRunCmd { hotDeck }
