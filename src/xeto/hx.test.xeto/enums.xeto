// Enum bound to a Fantom enum with the same item names
TestFanEnum: Enum {
  alpha
  beta
}

// Enum bound to a Fantom KeyedEnum
TestFanKeyedEnum: Enum {
  def <key:"default">
  iconXs <key:"icon-xs">
  plain
}

TestFanEnumSlots: Dict {
  a: TestFanEnum
  b: TestFanEnum "beta"
  c: TestFanKeyedEnum
  d: TestFanKeyedEnum "icon-xs"
  e: TestFanKeyedEnum?
}
