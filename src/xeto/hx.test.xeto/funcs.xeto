//////////////////////////////////////////////////////////////////////////
// APIs
//////////////////////////////////////////////////////////////////////////

+Funcs {

  // ping API
  ping1: Func { returns: Date }

  // ping API (not bound with facet)
  ping2: Func { returns: Date }

  // file upload shape: single file param
  testFileUpload: Func { file: File, returns: Obj? }

  // file download shape: file return
  testFileDownload: Func { returns: File? }

  // not the upload shape: file must be the only param
  testFileTwoParams: Func { a: File, b: Str, returns: Obj? }

  // Axon

  // add in Axon
  add1: Func { a: Number, b: Number, returns: Number
    <axon:"a + b">
  }

  // add in Axon, but source excluded from docs
  add1NoSrc: Func <nosrc> { a: Number, b: Number, returns: Number
    <axon:"a + b">
  }

  // add in Fantom
  add2: Func { a: Number, b: Number, returns: Number }

  // add in Fantom, but not allowed
  add3: Func { a: Number, b: Number, returns: Number }

  // add in comp blocks
  add4: Func { a: Number, b: Number, returns: Number
  /* TODO
    <compTree:---
      @root: Comp {
        a @a: Var {}
        b @b-id: Var {}
        returns: Var {
          links: {
            val: Link { fromRef: @add, fromSlot: "out"  }
          }
        }
        @add: TestNumberAdd {
          links: {
            in1: Link { fromRef: @a, fromSlot: "val" }
            in2: Link { fromRef: @b-id, fromSlot: "val" }
          }
        }
      }
      --->
  */
  }

//////////////////////////////////////////////////////////////////////////
// Validate Rules
//////////////////////////////////////////////////////////////////////////

  // rule func on an instance: flags the offending tag
  testValidateMinMax: Func <validateRule:@hx.test.xeto::testFuncMinMax> {
    spec: Spec, val: Obj?, returns: Obj?
    <axon:"if (val.has(\"min\") and val.has(\"max\") and val->min > val->max) {slot:\"min\"}">
  }

  // rule func on a value position: no slot to flag
  testValidateEven: Func <validateRule:@hx.test.xeto::testFuncEven> {
    spec: Spec, val: Obj?, returns: Obj?
    <axon:"if (val.toStr.size.isOdd) {}">
  }

  // rule func on one slot of a type
  testValidateNote: Func <validateRule:@hx.test.xeto::testFuncNote> {
    spec: Spec, val: Obj?, returns: Obj?
    <axon:"if (val.trim.isEmpty) {}">
  }
}

//////////////////////////////////////////////////////////////////////////
// Helper Types
//////////////////////////////////////////////////////////////////////////

InterfaceA: Interface {
  m1: Func <new> { returns: This }
  m9: Func <new> { returns: This }

  s1: Func <static> { returns: Obj }
  s9: Func <static> { returns: Obj }

  i1: Func { returns: Obj }
  i2: Func <virtual> { returns: Str }
  i9: Func <virtual> { returns: Str }
}

InterfaceB: InterfaceA {
  m1: Func <new> { returns: This }
  s1: Func <static> { returns: Str }
  i1: Func { returns: Date }
  i2: Str
}

