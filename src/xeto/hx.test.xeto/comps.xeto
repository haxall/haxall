TestFolder : Comp {
}

TestAdd : Comp {
  in1: TestVal
  in2: TestVal
  out: TestVal <transient>
}

TestNumberAdd : Comp {
  in1: Number
  in2: Number
  out: Number <transient, output>
}

TestRamp : Comp {
  out: TestVal <transient>
  amplitude: Float 50
}

TestCounter : Comp {
  out: TestVal <output>
}

TestComposite : Comp {
  descr: "test descr"
  dur: Duration "5min"
  a: TestAdd {
     in1: {val:7}
     in2: {val:5}
  }
  nest: TestFolder {
    b: TestAdd {
       in1: {val:17}
       in2: {val:15}
    }
  }
}

TestFoo: Comp {
  a: Str "alpha"
  b: Str "beta"
  c: Str?
  methodEcho: Func { arg:Obj? }
  methodSquare: Func <axon:"a*a"> { a: Number, returns: Number }
  methodBad1: Func { arg: Str }
  methodBad2: Func { arg: Str }
  methodBad3: Func { arg: Str }
  methodBad4: Func { arg: Str }
  methodUpper: Func <axon:"""(""+x).upper"""> { x: Str, returns: Str }
  methodThis: Func <axon:"this"> { ignore: Str, returns: Obj }
}

TestVal : Dict {
  val: Number
  status: Str
}

TestAxonSquare : Comp {
  in: Number
  out: Number
  onExecute: Func <axon:"""do
      in: this.get("in")
      this.set("out", in*in)
    end
    """>
}

TestIncrement : Comp {
  in: Number
  out: Number
  onExecute: Func <axon:"""this.set("out",  this->in + 1)""">
}

TestPoint: Dict {
  x: Number
  y: Number
}

TestMixinComp: Comp
TestAndComp: TestIncrement & TestMixinComp

TestAxonComposite : Comp {
  in: Number
  out: Number <link:"b.out"> // this.out -> b.out

  str: Str "something here"
  point: TestPoint { x:12, y:34 }

  a: TestAxonSquare {
    in: Number <link:"in"> // this.in -> a.in
  }

  b: TestAxonSquare {
    in: Number <link:"a.out"> // a.out -> b.in
  }
}

TestDeep2Composite : Comp {
  topIn: Number
  sub1: TestAxonComposite
  topOut: Number <link:"folder.sub2.out">
  folder: Comp {
    sub2: TestAxonComposite
    sub3: TestDeep1Composite {
      in: Number <link:"topIn">
    }
  }
}

TestDeep1Composite : Comp {
  in: Number
  bar: Comp {
    qux: Comp {
      a: TestAxonSquare {
        in: Number <link:"in"> // this.in-> a.in
      }

      b: TestAxonSquare {
        in: Number <link:"bar.qux.a.out"> // a.out -> b.in
      }
    }
  }
}

// Two comp loop with the loop cut on b.in1, so b reads a.out from the previous cycle
TestLoopCut : Comp {
  a: TestNumberAdd {
    in1: Number <link:"b.out">
    in2: Number 1
  }
  b: TestNumberAdd {
    in1: Number <link:"a.out", loopCut>
    in2: Number 10
  }
}

// Subtypes of TestLoopCut that pin how the cut inherits: it travels
// with the link it is written beside, and only a Marker counts

// re-declares b.in1's link with no loopCut: not cut
TestLoopCutSubSame : TestLoopCut {
  b: TestNumberAdd {
    in1: Number <link:"a.out">
  }
}

// adds c and moves b.in1 onto a new loop b <-> c with no loopCut: not cut
TestLoopCutSubMoved : TestLoopCut {
  c: TestNumberAdd {
    in1: Number <link:"b.out">
  }
  b: TestNumberAdd {
    in1: Number <link:"c.out">
  }
}

// changes only b.in2: still cut
TestLoopCutSubIn2 : TestLoopCut {
  b: TestNumberAdd {
    in2: Number 20
  }
}

// clears the cut with None: not cut
TestLoopCutSubNone : TestLoopCut {
  b: TestNumberAdd {
    in1: Number <link:"a.out", loopCut:None>
  }
}

// re-declares b.in1 with only a doc: link and cut both inherited
TestLoopCutSubDoc : TestLoopCut {
  b: TestNumberAdd {
    in1: Number <doc:"re-documented">
  }
}

TestNestedComp : Func {
  do: TestFolder {
    r1: TestRamp
    r2: TestRamp { amplitude: Float <minVal:50> 100 }
    a: TestAdd {
      in1: TestVal <link:"r1.out"> {
        val: 123
        status: "fault"
      }
      in2: TestVal <link:"r2.out">
    }
    deep2: TestDeep2Composite { topIn: 123 }
  }
}

//////////////////////////////////////////////////////////////////////////
// Remote loader handling covariant overrides
//////////////////////////////////////////////////////////////////////////

TestLabel : Comp {
  text: Str "label!"
  num: Number?
}

TestEdgeBox : Comp {
  center: Comp
}

TestEdgeBoxComposite: Comp {
  body: TestEdgeBox {
    center: TestLabel { num: "2001" }
  }
}

