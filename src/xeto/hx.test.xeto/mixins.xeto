// ignored
+ph::Site <foo:"building"> {
  area <doc:"no taek", foo: "AreaEditor", bar: "hello">
  newSlot: Str <foo:"hi">

  // globals contribute tag type inference, not slots
  *gdate: Date
  *gnum: Number <minVal:0>
}

+CurStatus <qux:"_self_"> {
  ok    <foo:"green">
  down  <foo:"yellow">
  fault <foo:"red">
}

+ElecAcQuadrant {
  q1 <foo:"Quadrant 1">
  q3 <foo:"Quadrant 3">  // ignore doc
}

// project naming standard used by graph compose navName seeding
+ZoneAirTempSensor <pointDis: "Zone Temp">
