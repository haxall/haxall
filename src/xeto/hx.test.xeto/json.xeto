// Entity supplies the 'id' and 'spec' members that a named instance carries;
// without them 'id' has no member to resolve against and decodes as a Str
JsonScalars: Entity {
  marker: Marker
  bool: Bool "true"
  int: Int 123
  float: Float 72
  number: Number 90kW
  str: "hello"
  ref: Ref "hx.test.xeto::fidelityA"
  uri: Uri "file.txt"
  date: Date "2024-11-25"
  time: Time "14:30:00"
  dateTime: DateTime "2024-11-25T10:24:35-05:00 New_York"
  span: Span "2024-11-25"

  tz: TimeZone "Chicago"
  unit: Unit "ft"
  unitQuantity: UnitQuantity "electricCurrentDensity"
  spanMode: SpanMode "yesterday"
  version: Version "4.0.9"
}

@jsonScalarsA: JsonScalars {
}

JsonNest: Entity {
  foo: JsonFoo
  dates: List <of:Date>
  untyped: List          // no 'of' meta, so items decode untyped
}

JsonFoo: {
  a: Int
  b: Str
}

@jsonNestA: JsonNest {
  foo: {a: 123, b: "xyz"}
  dates: {"2024-11-26", "2024-11-27"}
  untyped: {"a", "b"}
}

// Members whose plain JSON form only survives when the position names the
// type.  'looksNum' is declared Str even though its value reads as a Number.
JsonEdge: {
  na: NA
  int: Int
  float: Float
  unitless: Number
  looksNum: Str
}

// Entity row spec for grid tests, plus a subtype for heterogeneous rows
JsonRow: Entity {
  ts: DateTime
  v0: Number
}

JsonRowB: JsonRow {
  extra: Str
}

// A Grid subtype supplies its default row spec from the schema
JsonHisGrid: Grid <of:JsonRow>

