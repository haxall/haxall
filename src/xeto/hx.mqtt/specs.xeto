// MQTT connector to an MQTT Broker.
MqttConn: Conn {
  // Application protocols to use for TLS ALPN negotiation with the
  // broker. May be a Str or a list of Str.
  mqttAppProtocols: Obj?

  // Used on an [MqttConn.mqttConn] to indicate which certificate and key pair to use
  // for client authentication to the broker.
  mqttCertAlias: Str?

  // Whether to set the clean session flag on the connect request to the broker.
  mqttCleanSession: Bool?

  // The client identifier to use when connecting to the broker
  mqttClientId: Str?

  // Marker tag for MqttConn type
  mqttConn

  // Largest packet in bytes to accept from the broker. A larger message
  // is discarded and counted as a delivery error in the connector details.
  // Defaults to 16MB.
  mqttMaxPacketSize: Int?

  // How many times to retry sending messages that require acknowlegment
  mqttMaxRetry: Int?

  // How long to wait between retries for messages that require acknowlegment
  mqttRetryInterval: Duration?

  // How long the broker keeps the session after the network connection is
  // closed. If not set the session ends when the connection is closed. Use
  // '-1sec' for a session that never expires. Applies to MQTT 5.0 only.
  mqttSessionExpiryInterval: Duration?

  // MQTT protocol version
  mqttVersion: MqttVersion?

  // Password for authentication
  password: Password?

  // Universal resource identifier
  uri: Uri?

  // Username for authentication
  username: Str?
}

// Point which synchronizes data via a MQTT connector.
MqttPoint: ConnPoint {
  // Used on a proxy point to reference its parent [MqttConn.mqttConn]
  mqttConnRef: ConnRef? <of:MqttConn>

  // Marker tag for MqttPoint type
  mqttPoint
}

// String enums for mqttVersion
MqttVersion: Enum {
  v3_1_1
  v5
}

