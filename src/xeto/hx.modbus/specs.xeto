// Modbus connector
ModbusConn: Conn <icon:"modbus"> {
  // Applied to `modbusConn` or its [hx.conn::ConnTuning] rec to allow for gaps
  // in block reads. See [hx.modbus::doc#block-reads] for more information.
  modbusBlockGap: Int?

  // Applied to `modbusConn` or its [hx.conn::ConnTuning] rec to limit the maximum
  // number of registers to read in a block read. See [hx.modbus::doc#block-reads]
  // for more information.
  modbusBlockMax: Int?

  // Marker tag for ModbusConn type
  modbusConn

  // Applied to `modbusConn` to name the xeto spec which models this device,
  // such as "cc.isma.vav14::IsmaVav14". [connLearn()] walks its points instead
  // of a register map, and each learned point addresses its registers by
  // qname. See [hx.modbus::doc#addr-specs] for more information.
  modbusDeviceSpec: Str?

  // Minimum silence to enforce on the wire between two consecutive transactions.
  // Applied to `modbusConn` or its [hx.conn::ConnTuning] rec; a value on the conn
  // rec takes precedence. See [hx.modbus::doc#frame-delay] for more information.
  modbusFrameDelay: Duration?

  // How long to wait before timing out on a modbus read.
  modbusReadTimeout: Duration?

  // Applied to `modbusConn` to read for [connPing()]. The name of a point in
  // [ModbusConn.modbusDeviceSpec], such as "msi2", whose 'modbusCurAddr' is read.
  // Required when this connector is modelled by a device spec; a connector
  // with a register map defines a register named "ping" instead.
  modbusPingAddr: Str?

  // Applied to `modbusConn` to define the register map CSV file.
  // This URI must be a path relative to the project's home directory
  // or can be a "fan://" URI to a CSV file bundled in a pod. Optional when
  // every point addresses its registers by addr spec.
  modbusRegMapUri: Uri?

  // Applied to `modbusConn` to identify the slave address on this
  // modbus network.
  modbusSlave: Int?

  // How long to wait before timing out on a modbus write.
  modbusWriteTimeout: Duration?

  // Universal resource identifier
  uri: Uri?
}

// Point which synchronizes data via a Modbus connector.
ModbusPoint: ConnPoint {
  // Used on a proxy point to reference its parent [ModbusConn.modbusConn]
  modbusConnRef: Ref? <of:ModbusConn>

  // Modbus address to use for current value subscriptions. Either a register
  // name in the connector's register map, or the qname of a point spec such
  // as "acme.vav::Vav.points.zoneTemp", whose [ph.protocols::ModbusAddr] is
  // read from its 'modbusCurAddr'. See [hx.modbus::doc#current-points]
  // for format.
  modbusCur: Str?

  // Marker tag for ModbusPoint type
  modbusPoint

  // Used on a modbus proxy point to store the id of the entity in the
  // remote system used to write [ph::PhEntity.writeVal]. Either a register
  // name in the connector's register map, or the qname of a point spec,
  // whose [ph.protocols::ModbusAddr] is read from its 'modbusWriteAddr'.
  // See [hx.modbus::doc#writable-points] for format.
  modbusWrite: Str?
}

// ConnTuning mixin
+ConnTuning {
  // Applied to a `connTuning` rec to allow for gaps in block reads for every
  // [ModbusConn.modbusConn] which references it.  A value on the conn rec takes
  // precedence.  See [hx.modbus::doc#block-reads] for more information.
  modbusBlockGap: Int?

  // Applied to a `connTuning` rec to limit the maximum number of registers to
  // read in a block read for every [ModbusConn.modbusConn] which references it.
  // A value on the conn rec takes precedence.  See [hx.modbus::doc#block-reads]
  // for more information.
  modbusBlockMax: Int?

  // Applied to a `connTuning` rec to set the minimum silence on the wire between
  // two consecutive transactions for every [ModbusConn.modbusConn] which
  // references it.  A value on the conn rec takes precedence.  See
  // [hx.modbus::doc#frame-delay] for more information.
  modbusFrameDelay: Duration?
}

