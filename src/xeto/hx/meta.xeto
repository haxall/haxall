+Lib {
  // Define an extension spec for a library
  libExt: Spec?

  // Marks a library as Haxall system level only
  hxSysOnly: Marker?
}

+Spec {
  // Tags used for 3.1 det meta including rule ready and action UI
  defMeta: Dict?

  // Marks an `op` which reads the raw HTTP request itself instead of the
  // standard argument decoding.  The method rules are also delegated: the
  // op accepts any HTTP method rather than the GET/POST contract.  Such
  // functions are not callable outside of an HTTP request.
  opWebReq: Marker? <nodoc>

  // Marks an `op` which writes the raw HTTP response itself instead of
  // the standard result encoding.  Such functions are not callable outside
  // of an HTTP request.
  opWebRes: Marker? <nodoc>
}

