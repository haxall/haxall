+Lib {
  // Define an extension spec for a library
  libExt: Spec?

  // Marks a library as Haxall system level only
  hxSysOnly: Marker?
}

+Spec {
  // Tags used for 3.1 det meta including rule ready and action UI
  defMeta: Dict?

  // Marks an `op` which services part or all of the HTTP request itself
  // instead of using the standard request/response handling.  The function
  // signature declares which part: no parameters means it reads the web
  // request itself, and a 'None' return means it writes the web response
  // itself.  Such functions are not callable outside of an HTTP request.
  opWeb: Marker? <nodoc>
}

