+Lib {
  // Define an extension spec for a library
  libExt: Spec?

  // Marks a library as Haxall system level only
  hxSysOnly: Marker?
}

+Spec {
  // Tags used for 3.1 det meta including rule ready and action UI
  defMeta: Dict?

  // Marks an `op` which services the HTTP request itself instead of using
  // the standard request/response handling.  The dispatcher performs no
  // argument decoding, no GET method check, and no response encoding; the
  // function takes no parameters and reads the web request and writes the
  // web response directly.  Such functions are not callable outside of an
  // HTTP request and are excluded from the generated OpenAPI schema.
  opWeb: Marker?
}

