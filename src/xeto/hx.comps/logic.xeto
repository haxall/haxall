// The base spec for all logic components
Logic: HxComp <abstract> {
  // The computed value
  out: StatusBool? <summary, transient, readonly, output>
}

// Computes the logical negation of its input. An invalid input is false.
Not: Logic {
  in: StatusBool? <summary, transient>
}

// The base spec for all logic components that operate on up to four inputs.
// Inputs with an invalid status are not used in the calculation, but their
// status is still propagated to out.
QuadLogic: Logic <abstract> {
  // Input A
  inA: StatusBool? <summary, transient>

  // Input B
  inB: StatusBool? <summary, transient>

  // Input C
  inC: StatusBool? <transient>

  // Input D
  inD: StatusBool? <transient>
}

// Computes the logical "and" of its inputs
And: QuadLogic

// Computes the logical "or" of its inputs
Or: QuadLogic

// Computes the exclusive-or of its inputs
Xor: QuadLogic

// The base spec for all mathematical comparison operators
Comparison: Logic <abstract> {
  // Input A
  inA: StatusNumber? <summary, transient>

  // Input B
  inB: StatusNumber? <summary, transient>
}

// Computes A > B
GreaterThan: Comparison

// Computes A >= B
GreaterThanEqual: Comparison

// Computes A < B
LessThan: Comparison

// Computes A <= B
LessThanEqual: Comparison

// Computes A == B
Equal: Comparison

// Computes A != B
NotEqual: Comparison

// The base spec for comparison operators with hysteresis.  A non-zero
// `deadband` keeps `out` from toggling while `inA` hovers near `inB`.
// For a fixed threshold, link a `NumberConst` to `inB`, since a value
// set on a transient slot is not saved.
//
// A null input sets `out` to null and keeps the state.  An invalid
// status holds the state and the value of `out`, and passes the merged
// status through.  A fault holds the state and gives the held value
// (`initOut` before the first value) with the merged status plus fault.
// These are faults: a negative or NaN `deadband` or a `deadband` unit
// that does not fit `inB`, whatever the input status, and a NaN input
// with a valid status.  `inA` and `inB` must have compatible units, as
// for `Comparison`.
ComparisonHys: Logic <abstract> {
  // Input A
  inA: StatusNumber? <summary, transient>

  // Input B
  inB: StatusNumber? <summary, transient>

  // Width of the hysteresis band, not negative, in the unit of `inB`, its
  // delta unit (`°F` or `Δ°F` for an `inB` in `°F`), or unitless
  deadband: Number <minVal:0> 0

  // The previous value of `out` assumed by the first execute.
  initOut: Bool "false"
}

// Computes A > B with hysteresis: `out` turns true when A > B and false
// when A <= B - deadband.  This is the CDL `Reals.Greater` block, or
// `Reals.GreaterThreshold` with the threshold linked to `inB`.
GreaterThanHys: ComparisonHys

// Computes A < B with hysteresis: `out` turns true when A < B and false
// when A >= B + deadband.  This is the CDL `Reals.Less` block, or
// `Reals.LessThreshold` with the threshold linked to `inB`.
LessThanHys: ComparisonHys

// Converts a number to a bool with hysteresis: `out` turns true when
// `in` > `high` and false when `in` < `low`.  This is the CDL
// `Reals.Hysteresis` block.  Nulls, invalid statuses and faults are
// handled as for `ComparisonHys`.  These are faults whatever the status
// of `in`: a `high` not greater than `low`, a NaN limit, and limits
// whose units differ from each other or from `in`, where a unitless
// value fits any unit.
Hysteresis: Logic {
  // Input
  in: StatusNumber? <summary, transient>

  // `out` turns false when `in` drops below this value.
  low: Number

  // `out` turns true when `in` rises above this value.
  high: Number

  // The previous value of `out` assumed by the first execute.
  initOut: Bool "false"
}
