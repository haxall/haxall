// Presentation info for a spec bound by its instance name pattern:
// `pi-<lib dotted name with dashes>-<Name>` such as `@pi-ph-points-RunCmd`.
// Instances from multiple libs merge per tag: more specific types win
// over their supertypes, then downstream libs win over upstream libs.
// Only types are bound; a slot is presented by its type.
Pi: Dict {
  // Icon to use for visualization
  icon: Icon?

  // Default color for visualization
  color: ColorName?

  // Display text
  text: Text? <noInherit>

  // Plural display text
  plural: Text? <noInherit>

  // Abbreviation for a chip or narrow column
  abbr: Text?

  // Customer specific display name standard for point specs;
  // seeds the navName of points created from templates
  pointDis: Str?

  // HTML template to render widget type
  widget: Sketch? <nodoc>

  // HTML template to render spec values in a CardView
  card: Sketch? <nodoc>

  // HTML template to render spec values as item cells in lists, trees, tables
  cell: Sketch? <nodoc>

  // HTML template to render spec values in forms
  input: Sketch? <nodoc>

  // SVG template to render spec as a block in a wiresheet view
  block: Sketch? <nodoc>

  // Tailwind CSS class list
  tw: Str? <nodoc>

  // TODO - temp shim until we switch to sketches
  inputType: Ref? <of:Spec>

  // Presentation of enum items keyed by item name
  slots: Dict? <of:Pi>
}

// Icon represents a logical SVG icon name against installed manifest.
Icon: Scalar "blank"

// Axon template for HTML and SVG markup
Sketch: Scalar ""

// Text wraps a string for display with localization macro support.
// ```
// Localization "$<key>"       // for keys in "pi" pod itself
// Localization "$<pod::key>"  // for keys in other pods
// ```
Text: Scalar ""

// Format pattern used to format values to text
Format: Scalar ""

// Xeto interface for [fan.pi::PiFuture]
PiFuture: Interface

// Palette color name.
ColorName: Enum {
  slate    // Slate
  gray     // Gray
  zinc     // Zinc
  neutral  // Neutral
  stone    // Stone
  red      // Red - errors
  orange   // Orange - warnings, faults
  amber    // Amber
  yellow   // Yellow - down
  lime     // Lime
  green    // Green - ok, success
  emerald  // Emerald
  teal     // Teal
  cyan     // Cyan
  sky      // Sky
  blue     // Blue - informational
  indigo   // Indigo
  violet   // Violet
  purple   // Purple - abnormal
  fuchsia  // Fuchsia
  pink     // Pink
  rose     // Rose
}

// SelectionMode
SelectMode: Enum {
  disabled   // Selection is disabled
  single     // Can select only one item
  multi      // Can select one or more items
}

// Subject navigation identifier formatted as "/provider/tail?params#frag".
// The `of` meta names the resolved referent type: a single item such as
// `Sni<of:Equip>`, or a collection such as `Sni<of:Collection<of:Point>>`.
Sni: Scalar

