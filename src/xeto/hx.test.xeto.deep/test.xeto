// Test spec
Beta : Dict {
}

// Subtype used to verify rules and mixins apply thru transitive depends
DeepRuleSubject: TestRuleSubject


@norm-instance: Dict {
  metaNum:"987"
}

+Alpha <metaQ, metaNum: "456">

+Funcs {
  testDeepAdd: Func <axon:"a+b"> { a: Number, b: Number, returns: Number }
}


// downstream overrides of hx.test.xeto pi instances
@pi-hx-test-xeto-PiTestA: Pi {
  color: "blue"
}

@pi-hx-test-xeto-PiTestEnum: Pi {
  slots: {
    y: { color: "teal" }
    z: { icon: "tag" }
  }
}
