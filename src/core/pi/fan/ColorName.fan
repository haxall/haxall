using xeto

**
** Palette color name.
**
@Js @Gen
enum class ColorName
{
  ** Slate
  slate,

  ** Gray
  gray,

  ** Zinc
  zinc,

  ** Neutral
  neutral,

  ** Stone
  stone,

  ** Red - errors
  red,

  ** Orange - warnings, faults
  orange,

  ** Amber
  amber,

  ** Yellow - down
  yellow,

  ** Lime
  lime,

  ** Green - ok, success
  green,

  ** Emerald
  emerald,

  ** Teal
  teal,

  ** Cyan
  cyan,

  ** Sky
  sky,

  ** Blue - informational
  blue,

  ** Indigo
  indigo,

  ** Violet
  violet,

  ** Purple - abnormal
  purple,

  ** Fuchsia
  fuchsia,

  ** Pink
  pink,

  ** Rose
  rose
}

